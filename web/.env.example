AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_RETRY_ATTEMPTS=3
OPENAI_RETRY_DELAY_MS=350

# Optional fallback provider. Set AI_PROVIDER=anthropic to use it.
ANTHROPIC_API_KEY=your_claude_api_key
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_RETRY_ATTEMPTS=3
ANTHROPIC_RETRY_DELAY_MS=350
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/isf_agent?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/isf_agent?schema=public
AUTH_SECRET=replace_with_a_strong_random_secret
AUTH_URL=http://localhost:3000
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change_me
ADMIN_SEED_NAME=ISF Admin
ENABLE_LOCAL_ADMIN_SHORTCUT=false
